---
import '@fontsource-variable/unbounded';
import '@fontsource-variable/onest';
import '../styles/global.css';
import { site, faq, services } from '../data/config';

const ogImage = `${site.url}/img/work-2-after.svg`;
const ymId = import.meta.env.PUBLIC_YM_ID as string | undefined;
const gaId = import.meta.env.PUBLIC_GA_ID as string | undefined;

const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    name: site.brand,
    description: site.description,
    url: site.url,
    telephone: '+' + site.phone,
    image: ogImage,
    priceRange: '25 000–90 000 ₸',
    address: { '@type': 'PostalAddress', addressLocality: site.city, addressCountry: 'KZ' },
    areaServed: site.city,
    openingHours: 'Mo-Su 08:00-21:00',
    aggregateRating: { '@type': 'AggregateRating', ratingValue: site.rating.value, reviewCount: 100 },
    makesOffer: services.map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s.title } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#f6f7f2" />
    <link rel="icon" type="image/svg+xml" href={import.meta.env.BASE_URL + "favicon.svg"} />
    <link rel="canonical" href={site.url + '/'} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={site.url + '/'} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    {ymId && (
      <script is:inline define:vars={{ ymId }}>
        (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};m[i].l=1*new Date();k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})(window,document,'script','https://mc.yandex.ru/metrika/tag.js','ym');
        ym(ymId,'init',{clickmap:true,trackLinks:true,accurateTrackBounce:true});
      </script>
    )}
    {gaId && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>}
    {gaId && (
      <script is:inline define:vars={{ gaId }}>
        window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config',gaId);
      </script>
    )}
    <script is:inline define:vars={{ ymId: ymId || '', gaId: gaId || '' }}>
      window.track = function (name, params) {
        try { if (ymId && window.ym) window.ym(ymId, 'reachGoal', name, params); } catch (e) {}
        try { if (gaId && window.gtag) window.gtag('event', name, params || {}); } catch (e) {}
      };
    </script>
  </head>
  <body>
    <a class="skip" href="#main">К содержимому</a>
    <slot />
  </body>
</html>
