---
import Base from '../layouts/Base.astro';
import {
  site, nav, hero, objectTypes, cleanTypes, calc, services, includes, extras, works, worksVisible,
  videos, clients, why, steps, faq, finalCta,
} from '../data/config';

const money = (n: number) => new Intl.NumberFormat('ru-RU').format(n).replace(/ /g, ' ') + ' ₸';
const wa = (text = site.waDefault) => `https://wa.me/${site.phone}?text=${encodeURIComponent(text)}`;
const tel = `tel:+${site.phone}`;
const clientCfg = { site: { phone: site.phone, brand: site.brand }, objectTypes, cleanTypes, calc, extras };
const priceOf = (id: string, i: number) => cleanTypes.find((c) => c.id === id)!.tariff[i][1];

const waIcon = 'M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.2 14.2c-.2.6-1.300 1.200-1.800 1.200-.5.100-1.100.100-1.800-.100-.4-.1-.9-.3-1.600-.6-2.800-1.200-4.600-4-4.700-4.200-.1-.2-1.100-1.500-1.100-2.800s.7-2 1-2.300c.2-.3.500-.3.700-.3h.5c.2 0 .4 0 .6.500l.8 2c.1.200.1.300 0 .5l-.3.500-.4.500c-.1.100-.3.300-.1.600.2.300.7 1.200 1.500 1.900 1 .9 1.900 1.200 2.200 1.300.3.100.4.100.6-.1l.8-1c.2-.3.400-.2.600-.1l1.900.9c.3.100.4.200.5.300.1.200.1.800-.1 1.400Z';
---
<Base>
  <header class="header" id="top">
    <div class="wrap header__in">
      <a class="logo" href="#top" aria-label={`${site.brand} — на главную`}>
        <svg width="30" height="30" viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="18" fill="var(--accent)"/><path d="M32 12l4 12 12 4-12 4-4 12-4-12-12-4 12-4z" fill="#fff"/></svg>
        <span>{site.brand}</span>
      </a>
      <nav class="nav" id="nav" aria-label="Основное меню">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
        <a class="nav__tel" href={tel}>{site.phoneDisplay}</a>
      </nav>
      <a class="btn btn--sm header__wa" href={wa()} data-wa="header" target="_blank" rel="noopener">Написать в WhatsApp</a>
      <button class="burger" id="burger" aria-label="Открыть меню" aria-expanded="false" aria-controls="nav"><span></span><span></span><span></span></button>
    </div>
  </header>

  <main id="main">
    <!-- HERO -->
    <section class="hero">
      <div class="wrap hero__grid">
        <div class="hero__text">
          <p class="badge"><span class="badge__star" aria-hidden="true">★</span> <b>{site.rating.value}</b> в {site.rating.source}</p>
          <h1>{hero.title}</h1>
          <p class="lead">{hero.lead}</p>
          <a class="btn btn--lg" href={wa()} data-wa="hero" target="_blank" rel="noopener">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={waIcon}/></svg>{hero.cta}
          </a>
          <ul class="benefits">
            {hero.benefits.map((b) => <li><svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10.500l4 4 8-9" fill="none" stroke="currentColor" stroke-width="2.200" stroke-linecap="round" stroke-linejoin="round"/></svg>{b}</li>)}
          </ul>
        </div>

        <!-- КАЛЬКУЛЯТОР -->
        <div class="calc" id="calc" aria-labelledby="calc-title">
          <h2 id="calc-title" class="calc__title">Рассчитайте стоимость</h2>

          <fieldset class="seg" aria-label="Тип объекта">
            {objectTypes.map((o, i) => (
              <label><input type="radio" name="obj" value={o.id} checked={i === 0} /><span>{o.label}</span></label>
            ))}
          </fieldset>

          <div class="field">
            <label for="area-num">Площадь, м²</label>
            <div class="area">
              <input type="range" id="area-range" min={calc.minArea} max={calc.maxArea} value={calc.defaultArea} aria-label="Площадь, ползунок" />
              <input type="number" id="area-num" min={calc.minArea} max="1000" value={calc.defaultArea} inputmode="numeric" />
            </div>
            <div class="area__scale"><span>{calc.minArea}</span><span>{calc.maxArea}+</span></div>
          </div>

          <fieldset class="field">
            <legend>Вид уборки</legend>
            <div class="seg seg--3">
              {cleanTypes.map((c, i) => (
                <label><input type="radio" name="clean" value={c.id} checked={i === 1} /><span>{c.label}</span></label>
              ))}
            </div>
          </fieldset>

          <label class="check">
            <input type="checkbox" id="vacuum" />
            <span>{calc.vacuum.label} <b>+{money(calc.vacuum.price)}</b></span>
          </label>

          <button type="button" class="link-btn" id="extras-toggle" aria-expanded="false" aria-controls="extras-box">
            <span id="extras-toggle-t">Добавить услуги к расчёту</span>
          </button>
          <div class="collapse" id="extras-box">
            <div class="collapse__in">
              <p class="hint">Допы считаем за 1 единицу — количество уточним в WhatsApp.</p>
              {extras.map((e) => (
                <label class="check check--sm">
                  <input type="checkbox" class="extra" value={e.id} />
                  <span>{e.title} <em>{e.priceText}</em></span>
                </label>
              ))}
            </div>
          </div>

          <div class="total">
            <span>Предварительная стоимость</span>
            <output id="total" aria-live="polite">—</output>
          </div>
          <a class="btn btn--block" id="calc-wa" href={wa()} target="_blank" rel="noopener">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={waIcon}/></svg>Уточнить цену и дату в WhatsApp
          </a>
          <p class="calc__note">{calc.note}</p>
        </div>
      </div>
    </section>

    <!-- УСЛУГИ -->
    <section class="sec" id="services">
      <div class="wrap">
        <h2 class="sec__title reveal">Три вида уборки — под любую задачу</h2>
        <div class="cards3">
          {services.map((s) => (
            <article class="card reveal">
              <p class="card__tag">{s.tag}</p>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
              <p class="card__price">от {money(priceOf(s.id, 0))} <small>до 40 м²</small></p>
              <a class="card__link" href="#includes" data-tab={s.tab}>Что входит в уборку →</a>
            </article>
          ))}
        </div>
        <p class="after-cards reveal">Не знаете, какую уборку выбрать? <a href={wa('Здравствуйте! Не знаю, какая уборка мне нужна. Отправляю фото.')} data-wa="choose" target="_blank" rel="noopener">Отправьте фото в WhatsApp</a></p>
      </div>
    </section>

    <!-- ЦЕНЫ -->
    <section class="sec sec--tint" id="prices">
      <div class="wrap">
        <h2 class="sec__title reveal">Стоимость уборки квартир в Алматы</h2>
        <div class="table-scroll reveal" tabindex="0" role="region" aria-label="Таблица цен, можно прокручивать">
          <table class="prices">
            <thead><tr><th scope="col">Вид уборки</th><th scope="col">15–40 м²</th><th scope="col">60 м²</th><th scope="col">80 м²</th></tr></thead>
            <tbody>
              {cleanTypes.map((c) => (
                <tr><th scope="row">{c.label}</th>{c.tariff.map(([, p], i) => <td>{i === 0 ? 'от ' : ''}{money(p)}</td>)}</tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="muted reveal">До 40 м² действует минимальная стоимость выезда. Для большей площади цена рассчитывается пропорционально.</p>
        <a class="btn reveal" href={wa('Здравствуйте! Хочу уточнить цену уборки моей квартиры.')} data-wa="prices" target="_blank" rel="noopener">Уточнить цену моей уборки</a>
      </div>
    </section>

    <!-- ЧТО ВХОДИТ -->
    <section class="sec" id="includes">
      <div class="wrap">
        <h2 class="sec__title reveal">Что именно убираем</h2>
        <div class="tabs reveal" role="tablist" aria-label="Вид уборки">
          {includes.map((t, i) => (
            <button role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab={t.id}>{t.label}</button>
          ))}
        </div>
        {includes.map((t, i) => (
          <div class="panel" role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} hidden={i !== 0}>
            <div class="zones">
              {t.zones.map((z, zi) => (
                <div class="zone">
                  <span class="zone__n">{String(zi + 1).padStart(2, '0')}</span>
                  <h3>{z.title}</h3>
                  <ul>{z.items.map((it) => <li>{it}</li>)}</ul>
                </div>
              ))}
            </div>
            <p class="note">{t.note}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- РАБОТЫ -->
    <section class="sec sec--tint" id="works">
      <div class="wrap">
        <h2 class="sec__title reveal">Наши работы: до и после</h2>
        <p class="muted reveal">Потяните разделитель, чтобы сравнить. Нажмите «Увеличить» для просмотра.</p>
        <div class="works" id="works-grid">
          {works.map((w, i) => (
            <figure class="work reveal" data-extra={i >= worksVisible ? '' : undefined} hidden={i >= worksVisible}>
              <div class="ba" style="--pos:50%" data-before={w.before} data-after={w.after} data-title={w.title}>
                <img class="ba__img" src={w.after} alt={`${w.title} — после уборки`} width="800" height="600" loading="lazy" decoding="async" />
                <img class="ba__img ba__before" src={w.before} alt={`${w.title} — до уборки`} width="800" height="600" loading="lazy" decoding="async" />
                <span class="ba__line" aria-hidden="true"><span class="ba__knob"><svg width="20" height="20" viewBox="0 0 20 20"><path d="M7 5l-5 5 5 5M13 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span></span>
                <input class="ba__range" type="range" min="0" max="100" value="50" aria-label={`Сравнение до/после: ${w.title}`} />
              </div>
              <figcaption>
                <span>{w.title}</span>
                <button type="button" class="zoom" aria-label={`Увеличить: ${w.title}`}>Увеличить</button>
              </figcaption>
            </figure>
          ))}
        </div>
        {works.length > worksVisible && <button type="button" class="btn btn--ghost" id="more-works">Ещё работы</button>}

        <h3 class="sub reveal">Уборка в движении</h3>
        <div class="videos">
          {videos.map((v) => (
            <figure class="video reveal" data-src={v.src}>
              <button type="button" class="video__btn" aria-label={`Смотреть видео: ${v.title}`}>
                <img src={v.poster} alt="" width="800" height="600" loading="lazy" decoding="async" />
                <span class="play" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
              </button>
              <figcaption>{v.title}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- КЛИЕНТЫ -->
    <section class="sec">
      <div class="wrap">
        <h2 class="sec__title reveal">Нам доверяют</h2>
        <p class="muted reveal">Убираем офисы, рестораны, клубы и учебные заведения Алматы.</p>
        <ul class="clients">
          {clients.map((c) => (
            <li class="client reveal">
              <span class="client__logo" aria-hidden="true">
                <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.600" stroke-linecap="round" stroke-linejoin="round">
                  {c.shape === 'building' && <path d="M5 21V4h9v17M14 9h5v12M8 8h3M8 12h3M8 16h3M3 21h18"/>}
                  {c.shape === 'cup' && <path d="M5 8h11v5a5 5 0 0 1-5 5H10a5 5 0 0 1-5-5zM16 9h2a2 2 0 0 1 0 5h-2M7 4v2M11 4v2"/>}
                  {c.shape === 'dumbbell' && <path d="M3 9v6M6 7v10M18 7v10M21 9v6M6 12h12"/>}
                  {c.shape === 'cap' && <path d="M2 9l10-5 10 5-10 5zM6 11.500V16c0 1.500 3 3 6 3s6-1.500 6-3v-4.500"/>}
                  {c.shape === 'cross' && <path d="M9 3h6v6h6v6h-6v6H9v-6H3V9h6z"/>}
                  {c.shape === 'bed' && <path d="M3 18V7M3 14h18v4M21 14v-2a3 3 0 0 0-3-3h-7v5M7 11.500h.01"/>}
                  {c.shape === 'bag' && <path d="M5 8h14l-1 12H6zM9 8V6a3 3 0 0 1 6 0v2"/>}
                  {c.shape === 'star' && <path d="M12 3l2.600 5.600 6 .7-4.500 4.100 1.200 6L12 16.500 6.700 19.400l1.200-6L3.400 9.300l6-.7z"/>}
                </svg>
              </span>
              <span>{c.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ДОПЫ -->
    <section class="sec sec--tint" id="extras">
      <div class="wrap">
        <h2 class="sec__title reveal">Дополнительные услуги</h2>
        <div class="cards4">
          {extras.map((e) => (
            <article class="extra-card reveal">
              <h3>{e.title}</h3>
              <p class="extra-card__price">{e.priceText}</p>
              {e.note && <p class="muted small">{e.note}</p>}
            </article>
          ))}
        </div>
        <a class="btn reveal" href={wa('Здравствуйте! Хочу обсудить дополнительные услуги.')} data-wa="extras" target="_blank" rel="noopener">Обсудить дополнительные услуги</a>
      </div>
    </section>

    <!-- ПОЧЕМУ МЫ -->
    <section class="sec">
      <div class="wrap">
        <h2 class="sec__title reveal">Почему выбирают нас</h2>
        <div class="why">
          {why.map((w, i) => (
            <article class="why__item reveal">
              <span class="why__n">{i + 1}</span>
              <h3>{w.title}</h3>
              <p>{w.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- КАК ЗАКАЗАТЬ -->
    <section class="sec sec--tint" id="order">
      <div class="wrap order">
        <div>
          <h2 class="sec__title reveal">Как заказать</h2>
          <ol class="steps">
            {steps.map((s) => (
              <li class="reveal"><span class="steps__n">{s.n}</span><div><h3>{s.title}</h3><p>{s.text}</p></div></li>
            ))}
          </ol>
        </div>
        <aside class="contact reveal" aria-label="Связаться с нами">
          <p class="contact__t">Свяжитесь удобным способом</p>
          <a class="btn btn--block btn--light" href={wa()} data-wa="order" target="_blank" rel="noopener">Написать в WhatsApp</a>
          <a class="contact__tel" href={tel} data-tel="order">{site.phoneDisplay}</a>
          <p class="contact__h">{site.hours}</p>
        </aside>
      </div>
    </section>

    <!-- FAQ -->
    <section class="sec" id="faq">
      <div class="wrap wrap--narrow">
        <h2 class="sec__title reveal">Частые вопросы</h2>
        <div class="faq">
          {faq.map((f, i) => (
            <div class="faq__item reveal">
              <h3><button type="button" class="faq__q" aria-expanded="false" aria-controls={`faq-a-${i}`} id={`faq-q-${i}`}>{f.q}<span class="faq__ic" aria-hidden="true"></span></button></h3>
              <div class="faq__a" id={`faq-a-${i}`} role="region" aria-labelledby={`faq-q-${i}`}><div><p>{f.a}</p></div></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ФИНАЛ -->
    <section class="final">
      <div class="wrap final__in reveal">
        <h2>{finalCta.title}</h2>
        <p>{finalCta.text}</p>
        <div class="final__actions">
          <a class="btn btn--lg btn--light" href={wa('Здравствуйте! Отправляю фото квартиры для расчёта.')} data-wa="final" target="_blank" rel="noopener">Отправить фото в WhatsApp</a>
          <a class="final__tel" href={tel} data-tel="final">{site.phoneDisplay}</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap footer__in">
      <div>
        <p class="footer__brand">{site.brand}</p>
        <p>Клининг в {site.city}</p>
        <p>{site.hours}</p>
      </div>
      <div>
        <p><a href={tel}>{site.phoneDisplay}</a></p>
        <p><a href={wa()} data-wa="footer" target="_blank" rel="noopener">WhatsApp</a></p>
      </div>
      <nav aria-label="Навигация в подвале">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>
    </div>
    <p class="wrap footer__c">© {new Date().getFullYear()} {site.brand}</p>
  </footer>

  <a class="sticky-wa" href={wa()} data-wa="sticky" target="_blank" rel="noopener">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={waIcon}/></svg>Написать в WhatsApp
  </a>

  <dialog class="lightbox" id="lightbox" aria-label="Просмотр фото до и после">
    <form method="dialog"><button class="lightbox__x" aria-label="Закрыть">×</button></form>
    <p class="lightbox__t" id="lb-title"></p>
    <div class="lightbox__pair">
      <figure><img id="lb-before" alt="До уборки" /><figcaption>До</figcaption></figure>
      <figure><img id="lb-after" alt="После уборки" /><figcaption>После</figcaption></figure>
    </div>
  </dialog>

  <script type="application/json" id="cfg" set:html={JSON.stringify(clientCfg)} />
  <script>
    import '../scripts/main.ts';
  </script>
</Base>
